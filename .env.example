# Back2Owner Document Verification Environment Configuration
B2O_ENVIRONMENT=production
B2O_DEBUG=false

# Upload & Dimension Limits
B2O_MAX_UPLOAD_SIZE_BYTES=10485760   # 10 MB
B2O_MIN_UPLOAD_SIZE_BYTES=2048       # 2 KB
B2O_MIN_IMAGE_WIDTH=320
B2O_MIN_IMAGE_HEIGHT=200

# Quality Assessment Thresholds
B2O_BLUR_THRESHOLD=90.0              # Laplacian variance; <90 is blurry
B2O_MIN_BRIGHTNESS=45.0             # Mean luminance; <45 is dark
B2O_MAX_BRIGHTNESS=230.0            # Mean luminance; >230 is overexposed/glare
B2O_MIN_CONTRAST=22.0               # Standard deviation of luminance
B2O_CROP_EDGE_DENSITY_THRESHOLD=0.12 # Border strip edge density

# Field Matching Thresholds (0-100)
B2O_NAME_MATCH_THRESHOLD=80.0
B2O_NAME_BORDERLINE_THRESHOLD=50.0
B2O_DEPT_MATCH_THRESHOLD=75.0
B2O_DEPT_BORDERLINE_THRESHOLD=50.0

# OCR Settings
B2O_OCR_ENGINE=paddle               # 'paddle' or 'mock'
B2O_OCR_VERSION=PP-OCRv4
B2O_OCR_LANG=en

# Privacy
B2O_MASK_PII_IN_LOGS=true
B2O_RETAIN_ORIGINAL_IMAGE=false
